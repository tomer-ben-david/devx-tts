# devx-tts local environment (do not commit .env.local)
# Encrypt with: ./scripts/env-encrypt.sh

# VPS host
CONTABO_VM_IP=your-vps-ip-address

# Public hostname for the TTS gateway
TTS_DOMAIN=tts.your-domain.com

# GitHub Container Registry credentials
GHCR_USERNAME=your-ghcr-username
GHCR_TOKEN=your-ghcr-token

# Required - Encryption key for .env.local.encrypted
# Generate with: openssl rand -base64 32
ENV_ENCRYPTION_KEY=your-base64-encryption-key-here

# Required - API key for external access (stored in .env.local and encrypted)
DEVX_API_KEY=your-tts-api-key-here

# Optional - Hugging Face token for model downloads (if required by the image)
HF_TOKEN=your-huggingface-token
